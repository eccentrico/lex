# Lex environment configuration. Copy to .env and fill in.

# =============================================================================
# LLM (lex/llm.py — any OpenAI-compatible endpoint; DeepSeek by default)
# =============================================================================
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# LEX_MODEL=deepseek-v4-flash

# =============================================================================
# ZERODHA KITE CONNECT (services/kite_auth.py, services/kite_data.py)
# Market data, quotes, portfolio — auth is headless/TOTP-based, see README.
# =============================================================================
KITE_API_KEY=
KITE_SECRET_KEY=
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# =============================================================================
# LEX HOME (lex/paths.py) — where memory, sessions, watchlist, and saved
# research reports live. Defaults to ~/.lex if unset.
# =============================================================================
# LEX_HOME=~/.lex
